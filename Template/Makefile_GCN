#---------------------------------------------------------------------------------
# OctTemplate for GameCube: an Octave project with its own C++ (Source/), linked with the prebuilt
# engine (Engine/Build/GCN/libEngine.a: DolphinWorks' Engine page, or Octave's builder, makes it).
#
# Normally built by Octave's packager (DolphinWorks' Build runs it):
#   Octave.exe -headless -project <path>/OctTemplate.octp -build GameCube
# which runs this makefile, then writes Packaged/GameCube/ (.dol + .iso).
#
# By hand: make -f Makefile_GCN  -> Build/GCN/OctTemplate.dol
#
# Build switches (DolphinWorks sets them from its build options):
#   GECKOLOG=1  the engine's log, live over a USB Gecko (DolphinWorks' Debug console)
#   GDB=1       libogc's debug stub on the USB Gecko: the game waits at its start for GDB
#---------------------------------------------------------------------------------
.SUFFIXES:
.SECONDARY:

ifeq ($(strip $(DEVKITPPC)),)
$(error "Please set DEVKITPPC in your environment. export DEVKITPPC=<path to>devkitPPC")
endif

include $(DEVKITPPC)/gamecube_rules

# Where Octave-libogc is: the OCTAVE environment variable (DolphinWorks' Build sets it), else this.
export OCTAVE ?= $(abspath $(CURDIR)/../octave-libogc)

TARGET		:=	OctTemplate
BUILD		:=	Intermediate/GCN
SOURCES		:=	Source Generated
OUTPUT_DIR	:=	$(CURDIR)/Build/GCN

CFLAGS	= -g -O2 -Wall $(MACHDEP) $(INCLUDE) -DPLATFORM_GAMECUBE=1 -DPLATFORM_DOLPHIN=1 -DAPI_GX=1
CXXFLAGS	=	$(CFLAGS) -std=gnu++20

ifneq ($(GECKOLOG),)
CFLAGS	+=	-DOCT_GECKO_LOG=1
endif

# --wrap: the engine's own allocator (it tracks and logs what's allocated), as Octave's Standalone links
LDFLAGS	=	-g $(MACHDEP) -Wl,-Map,$(notdir $@).map -Wl,--wrap=malloc,--wrap=free,--wrap=realloc,--wrap=calloc,--wrap=memalign

LIBS	:=	-lEngine -lBullet -lasnd -lbba -lfat -logc -lm

ifneq ($(GDB),)
CFLAGS	+=	-DOCT_GDB=1
LIBS	:=	-ldb $(LIBS)
endif

ENGINE_LIB_DIR := $(OCTAVE)/Engine/Build/GCN
BULLET_LIB_DIR := $(OCTAVE)/External/Bullet/Build/GCN

ifneq ($(notdir $(BUILD)),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export VPATH	:=	$(foreach dir,$(SOURCES),$(abspath $(dir)))
export DEPSDIR	:=	$(CURDIR)/$(BUILD)

CFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES	:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))

export LD	:=	$(CXX)
export OFILES	:=	$(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

export INCLUDE	:=	-I$(CURDIR)/Source \
					-I$(OCTAVE)/Engine/Source \
					-I$(OCTAVE)/Engine/Source/Engine \
					-I$(OCTAVE)/External \
					-I$(OCTAVE)/External/Bullet \
					-I$(CURDIR)/$(BUILD) \
					-I$(LIBOGC_INC)

export LIBPATHS	:=	-L$(ENGINE_LIB_DIR) -L$(BULLET_LIB_DIR) -L$(LIBOGC_LIB)

export ENGINE_LIB := $(ENGINE_LIB_DIR)/libEngine.a
export OUTPUT	:=	$(OUTPUT_DIR)/$(TARGET)

.PHONY: $(BUILD) OutputDir clean

$(BUILD): OutputDir
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile_GCN

OutputDir:
	@[ -d $(OUTPUT_DIR) ] || mkdir -p $(OUTPUT_DIR)

clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT).dol $(OUTPUT).elf

#---------------------------------------------------------------------------------
else

$(OUTPUT).dol: $(OUTPUT).elf
$(OUTPUT).elf: $(OFILES) $(ENGINE_LIB)

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
